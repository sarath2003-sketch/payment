# PostgreSQL database URL for production
DATABASE_URL=postgresql://username:password@hostname:5432/amount_management_db

# Server configuration
PORT=5000
NODE_ENV=production
CORS_ORIGIN=http://localhost:5000  # Use the backend origin or production host URL

# Authentication and security
JWT_SECRET=your-strong-jwt-secret
JWT_EXPIRATION=24h
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123456

# File upload settings
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# SMS provider configuration (optional)
SMS_PROVIDER=console
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=your_account_sid
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_PHONE_NUMBER=+1234567890
